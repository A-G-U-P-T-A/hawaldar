# Nuclei binary only — templates fetch on first networked run (keeps image small).
ARG VERSION=3.3.7
FROM docker.io/library/alpine:3.20 AS down
ARG VERSION
RUN apk add --no-cache curl ca-certificates unzip \
	&& curl -fsSL "https://github.com/projectdiscovery/nuclei/releases/download/v${VERSION}/nuclei_${VERSION}_linux_amd64.zip" -o /tmp/t.zip \
	&& unzip -j /tmp/t.zip nuclei -d /usr/local/bin \
	&& chmod +x /usr/local/bin/nuclei
FROM docker.io/library/alpine:3.20
RUN apk add --no-cache ca-certificates && rm -rf /var/cache/apk/*
COPY --from=down /usr/local/bin/nuclei /usr/local/bin/nuclei
ENTRYPOINT ["nuclei"]
