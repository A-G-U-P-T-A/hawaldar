ARG VERSION=2.3.3
# glibc base: naabu releases link glibc + libpcap; alpine musl + gcompat shim
# broke exec ("missing dynamic library /usr/local/bin/naabu").
FROM docker.io/library/debian:bookworm-slim AS down
ARG VERSION
RUN apt-get update \
	&& apt-get install -y --no-install-recommends curl ca-certificates unzip \
	&& rm -rf /var/lib/apt/lists/* \
	&& curl -fsSL "https://github.com/projectdiscovery/naabu/releases/download/v${VERSION}/naabu_${VERSION}_linux_amd64.zip" -o /tmp/t.zip \
	&& unzip -j /tmp/t.zip naabu -d /usr/local/bin \
	&& chmod +x /usr/local/bin/naabu
FROM docker.io/library/debian:bookworm-slim
RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates libpcap0.8 \
	&& rm -rf /var/lib/apt/lists/*
COPY --from=down /usr/local/bin/naabu /usr/local/bin/naabu
# Fail the build (not the engagement) if the binary cannot exec on this arch/libc.
RUN /usr/local/bin/naabu -version
ENTRYPOINT []
CMD ["naabu"]
