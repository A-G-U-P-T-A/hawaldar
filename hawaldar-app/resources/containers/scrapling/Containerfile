# Minimal contained Scrapling recon — HTTP Fetcher + adaptive selectors.
# curl_cffi TLS impersonation only. No Playwright/Patchright, no CAPTCHA solver.
# Tag: localhost/hawaldar/scrapling:min
FROM docker.io/library/python:3.12-slim-bookworm
RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates \
	&& rm -rf /var/lib/apt/lists/*
WORKDIR /opt/hawaldar-scrapling
COPY recon.py ./
RUN pip install --no-cache-dir --upgrade pip \
	&& pip install --no-cache-dir "scrapling==0.4.14" "curl_cffi>=0.16.0" \
	&& rm -rf /root/.cache /tmp/*
# Host calls: python /opt/hawaldar-scrapling/recon.py …
# No ENTRYPOINT so readiness can run `python --version`.
