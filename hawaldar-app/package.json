{
  "name": "hawaldar-app",
  "version": "0.1.0",
  "description": "Hawaldar — authorized reconnaissance workstation (standalone Electron)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/A-G-U-P-T-A/hawaldar",
  "desktopName": "com.hawaldar.app",
  "author": {
    "name": "Hawaldar contributors",
    "email": "hawaldar@users.noreply.github.com"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "ensure-electron": "node scripts/ensure-electron.mjs",
    "dev": "node scripts/ensure-electron.mjs && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "brand:png": "node scripts/export-brand-png.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder && node scripts/ensure-electron.mjs",
    "dist:dir": "npm run build && electron-builder --dir && node scripts/ensure-electron.mjs"
  },
  "build": {
    "appId": "com.hawaldar.app",
    "productName": "Hawaldar",
    "copyright": "Copyright © 2026 Hawaldar contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.{node,dll}",
      "**/node_modules/@libsql/**",
      "**/node_modules/@lancedb/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "LICENSE-USAGE.md",
        "to": "LICENSE-USAGE.md"
      },
      {
        "from": "resources/installer/README.txt",
        "to": "README.txt"
      }
    ],
    "win": {
      "icon": "resources/brand/hawaldar.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hawaldar",
      "license": "LICENSE",
      "include": "resources/installer/hawaldar.nsh"
    },
    "mac": {
      "icon": "resources/brand/hawaldar.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ]
    },
    "linux": {
      "icon": "resources/brand/hawaldar.png",
      "category": "Development",
      "maintainer": "Hawaldar contributors <hawaldar@users.noreply.github.com>",
      "synopsis": "Authorized reconnaissance workstation. Requires Podman.",
      "description": "Hawaldar requires Podman (or Docker if already installed). Without a container engine, tools do not run. After install, open the app and use Set up Podman.",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.22.0",
    "@libsql/client": "^0.17.4",
    "@mastra/core": "1.59.0",
    "@mastra/lance": "1.3.0",
    "@mastra/libsql": "1.20.0",
    "@mastra/loggers": "1.2.0",
    "@mastra/memory": "1.26.2",
    "@mastra/observability": "1.17.0",
    "3d-force-graph": "^1.79.0",
    "apache-arrow": "^18.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.170.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
